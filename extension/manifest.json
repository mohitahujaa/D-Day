{
  "manifest_version": 3,
  "name": "D-Day",
  "version": "1.0.0",
  "description": "Select a deadline anywhere, extract it with a local AI model, and save it to Google Calendar after you review it.",
  "minimum_chrome_version": "110",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "D-Day",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "add-selection": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Add the selected text to D-Day"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
